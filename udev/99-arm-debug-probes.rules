# ARM Debug Probes udev rules
# Copy to /etc/udev/rules.d/ and reload: sudo udevadm control --reload-rules

# CMSIS-DAP compatible adapters
SUBSYSTEM=="usb", ATTR{idVendor}=="0d28", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="c251", MODE="0666"

# ST-Link V2
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3748", MODE="0666"
# ST-Link V2-1
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374b", MODE="0666"
# ST-Link V3
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374d", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374e", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374f", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3753", MODE="0666"

# J-Link
SUBSYSTEM=="usb", ATTR{idVendor}=="1366", MODE="0666"

# DAPLink / CMSIS-DAP
SUBSYSTEM=="usb", ATTR{idVendor}=="0d28", ATTR{idProduct}=="0204", MODE="0666"

# NXP LPC-Link2
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc9", MODE="0666"

# Atmel-ICE
SUBSYSTEM=="usb", ATTR{idVendor}=="03eb", ATTR{idProduct}=="2141", MODE="0666"

# MCU-Link
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc9", ATTR{idProduct}=="0143", MODE="0666"

# Nuvoton Nu-Link
SUBSYSTEM=="usb", ATTR{idVendor}=="0416", MODE="0666"

# WCH-Link
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="8010", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="8011", MODE="0666"
