              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>FCRBUSY</name>
              <description>Frequency Compensation Register Write Operation Busy (Read Only)\nNote: This bit is only used when DCOMPEN(RTC_CLKFMT[16]) is enabled.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The new register write operation is acceptable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The last write operation is in progress and new register write operation prohibited</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
