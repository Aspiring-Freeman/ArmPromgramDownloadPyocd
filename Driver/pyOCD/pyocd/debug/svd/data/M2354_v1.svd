          <addressOffset>0x104</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_HMAC_FDBCK0">
          <name>CRYPTO_HMAC_FDBCK44</name>
          <displayName>CRYPTO_HMAC_FDBCK44</displayName>
          <description>SHA/HMAC Output Feedback Data 44 After SHA/HMAC Operation</description>
          <addressOffset>0x108</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_HMAC_FDBCK0">
