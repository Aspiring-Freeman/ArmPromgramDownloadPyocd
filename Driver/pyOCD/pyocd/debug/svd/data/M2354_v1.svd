                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>DINOFF2</name>
              <description>I/O Pin Digital Input Path Disable Bit</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
