       </register>
       <register derivedFrom="PDMAx_DSCT0_DA">
          <name>PDMAx_DSCT2_DA</name>
          <displayName>PDMAx_DSCT2_DA</displayName>
          <description>Destination Address Register of PDMA Channel n</description>
          <addressOffset>0x28</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_DA">
          <name>PDMAx_DSCT3_DA</name>
          <displayName>PDMAx_DSCT3_DA</displayName>
