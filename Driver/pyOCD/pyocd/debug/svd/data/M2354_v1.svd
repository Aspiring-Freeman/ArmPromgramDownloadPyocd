          <addressOffset>0x14</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_ECC_X1_00">
          <name>CRYPTO_ECC_X1_04</name>
          <displayName>CRYPTO_ECC_X1_04</displayName>
          <description>ECC the X-coordinate Word4 of the First Point</description>
