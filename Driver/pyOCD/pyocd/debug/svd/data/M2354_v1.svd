                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Standby power-down wake-up pin De-bounce function Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>CLK_IOPDCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CLK_IOPDCTL</displayName>
          <description>GPIO Standby Power-down Control Register</description>
          <addressOffset>0xB0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IOHR</name>
              <description>GPIO Hold Release\nWhen GPIO enter standby power-down mode, all I/O status are hold to keep normal operating status. After chip was waked up from standby power-down mode, the I/O are still keep hold status until user set this bit to release I/O hold status.\nNote: This bit is auto cleared by hardware.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>CLK_HXTFSEL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CLK_HXTFSEL</displayName>
          <description>HXT Filter Select Register</description>
          <addressOffset>0xB4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HXTFSEL</name>
              <description>HXT Filter Select</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>HXT cutoff frequency is 24 MHz</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>HXT cutoff frequency is 4 MHz</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DPM</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0x4002F600</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x10</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x50</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x60</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>DPM_CTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_CTL</displayName>
          <description>Secure DPM Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0xA5000000</resetValue>
          <resetMask>0xFFFFFFF0</resetMask>
          <fields>
            <field>
              <name>DBGDIS</name>
              <description>Set Secure DPM Debug Disable Bit\nWhen this bit is read as 0, it can be written to 1 to configure the Secure DPM DBGDIS bit (DBGDISS).\nWhen written:\nNote: This bit can be set to 1 but cannot be cleared to 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trigger the process to set DBGDISS configuration bit</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>LOCK</name>
              <description>Set Secure DPM Debug Lock Bit\nWhen this bit is read as 0, it can be written to 1 to configure the Secure DPM LOCK bit (LOCKS).\nWhen written:\nNote: This bit can be set to 1 but cannot be cleared to 0.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trigger the process to set LOCKS configuration bit</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWCMP</name>
              <description>Secure DPM Password Compare Bit\nSet to enter the process of compare Secure DPM password.\nNote: This bit will be cleared after the comparison process is finished.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Compare Secure DPM password</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWUPD</name>
              <description>Secure DPM Password Update Bit\nSet to enter the process of updating Secure DPM password.\nNote 1: This bit should be set with PWCMP equal to 0.\nNote 2: This bit will be cleared after the update process is finished.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Update Secure DPM password</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN</name>
              <description>DPM Interrupt Enable Bit</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>DPM interrupt function Enabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>DPM interrupt function Disabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>DACCWDIS</name>
              <description>Secure DPM Debug Write Access Disable Bit\nThis bit disables the ability of external debugger to set Secure DPM registers for debug authentication. </description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>External debugger can set Secure DPM registers</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>External debugger cannot set Secure DPM registers</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>DACCDIS</name>
              <description>Debug Access Disable Bit\nThis bit disables the accessibility of external debugger to all DPM registers.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>External debugger can read/write DPM registers</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>External debugger cannot read/write DPM registers</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>RWVCODE</name>
              <description>Write Verify Code and Read Verify Code\nRead operation:</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>90</name>
                    <description>The write verify code, 0x5A, is needed to do a valid write to DPM_CTL</description>
                    <value>0x5a</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>165</name>
                    <description>The read access for DPM_CTL is correct</description>
                    <value>0xa5</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_STS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_STS</displayName>
          <description>Secure DPM Status Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFF0F0FF</resetMask>
          <fields>
            <field>
              <name>BUSY</name>
              <description>DPM Busy Flag (Read Only)\nThis bit indicates the DPM is busy.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>DPM is not busy and writing to any register is accepted</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>DPM is busy and other bits in DPM_STS register are not valid and writing to any register is ignored</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>INT</name>
              <description>DPM Interrupt Flag (Read Only)\nThis bit indicates the interrupt is triggered.\nNote: This bit is cleared automatically when PWCERR flag in both DPM_STS and DPM_NSSTS are 0.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Interrupt is not enabled or no password comparison flag is set</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Interrupt is enabled and PWCERR flag in either DPM_STS or DPM_NSSTS register is not cleared</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>PWCERR</name>
              <description>Secure DPM Password Compared Error Flag\nThis bit indicates the result of Secure DPM password comparison.\nWhen read:\nNote: This flag is write-one-clear.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The result of Secure DPM password is correct</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The result of Secure DPM password is incorrect</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWUOK</name>
              <description>Secure DPM Password Updated Flag\nThis bit indicates Secure DPM password has been updated successfully.\nWhen read:\nNote: This flag is write-one-clear.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No successful updating process has happened</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>There is at least one successful updating process since last clearing of this bit</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWFMAX</name>
              <description>Secure DPM Password Fail Times Maximum Reached Flag (Read Only)\nThis bit indicates if the fail times of comparing Secure DPM password reached max times.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Max time has not reached and Secure DPM password comparison can be triggered</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Max time reached and Secure DPM password comparison cannot be processed anymore</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>PWUCNT</name>
              <description>Secure DPM Password Updated Times (Read Only)\nThis bit indicates how many times of secure password has been updated.\nThe max value is 7. If PWUCNT reached the max value, Secure DPM password cannot be updated anymore.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DBGDIS</name>
              <description>Secure Debug Disable Flag (Read Only)\nThis bit indicates the current value of DBGDISS bit.\n{PWOK, LOCK, DBGDIS} bits define the current state of DPM.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>DEFAULT state.\nLOCKED state</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CLOSE state</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>5</name>
                    <description>OPEN state</description>
                    <value>#101</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>LOCK</name>
              <description>Secure Debug Lock Flag (Read Only)\nThis bit indicates the current value of LOCKS bit.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PWOK</name>
              <description>Secure Password OK Flag (Read Only)\nThis bit indicates the Secure DPM password has been checked and is correct.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The Secure DPM password has not been checked pass, yet</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The Secure DPM password has been checked pass since last cold reset</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_SPW0</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_SPW0</displayName>
          <description>Secure DPM Password 0</description>
          <addressOffset>0x10</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[31:0] to this register to update or compare Secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_SPW1</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_SPW1</displayName>
          <description>Secure DPM Password 1</description>
          <addressOffset>0x14</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[63:32] to this register to update or compare Secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_SPW2</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_SPW2</displayName>
          <description>Secure DPM Password 2</description>
          <addressOffset>0x18</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[95:64] to this register to update or compare Secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_SPW3</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_SPW3</displayName>
          <description>Secure DPM Password 3</description>
          <addressOffset>0x1C</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[127:96] to this register to update or compare Secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_NSCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_NSCTL</displayName>
          <description>Non-secure DPM Control Register</description>
          <addressOffset>0x50</addressOffset>
          <access>read-write</access>
          <resetValue>0xA5000000</resetValue>
          <resetMask>0xFFFFFFF0</resetMask>
          <fields>
            <field>
              <name>DBGDIS</name>
              <description>Set Non-secure DPM Debug Disable Bit\nWhen this bit is read as 0, it can be written to 1 to configure the Non-secure DPM DBGDIS bit (DBGDISNS).\nWhen written:\nNote: This bit can be set to 1 but cannot be cleared to 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trigger the process to set DBGDISNS configuration bit</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>LOCK</name>
              <description>Set Non-secure DPM Debug Lock Bit\nWhen this bit is read as 0, it can be written to 1 to configure the Non-secure DPM LOCK bit (LOCKNS).\nWhen written:\nNote: This bit can be set to 1 but cannot be cleared to 0.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trigger the process to set LOCKNS configuration bit</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWCMP</name>
              <description>Non-secure DPM Password Compare Bit\nSet to enter the process of compare Non-secure DPM password.\nNote: This bit will be cleared after the comparison process is finished.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Compare Non-secure DPM password</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWUPD</name>
              <description>Non-secure DPM Password Update Bit\nSet to enter the process of updating Non-secure DPM password.\nNote 1: This bit should be set with PWCMP equal to 0.\nNote 2: This bit will be cleared after the update process is finished.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Update Non-secure DPM password</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>DACCWDIS</name>
              <description>Debug Write Access Disable Bit\nThis bit disables the ability of external debugger to set Non-secure DPM registers for debug authentication. </description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>External debugger can set Non-secure DPM registers</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>External debugger cannot set Non-secure DPM registers</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>RWVCODE</name>
              <description>Write Verify Code and Read Verify Code\nRead operation:</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>90</name>
                    <description>The write verify code, 0x5A, is needed to do a valid write to DPM_NSCTL</description>
                    <value>0x5a</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>165</name>
                    <description>The read access for DPM_NSCTL is correct</description>
                    <value>0xa5</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_NSSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_NSSTS</displayName>
          <description>Non-secure DPM Status Register</description>
          <addressOffset>0x54</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFF0F0FF</resetMask>
          <fields>
            <field>
              <name>BUSY</name>
              <description>DPM Busy Flag (Read Only)\nThis bit indicates the DPM is busy.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>DPM is not busy and writing to any register is accepted</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>DPM is busy and other bits in DPM_NSSTS register are not valid and writing to any register is ignored</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>PWCERR</name>
              <description>Non-secure DPM Password Compared Error Flag\nThis bit indicates the result of Non-secure DPM password comparison.\nNote: This flag is write-one-clear.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The result of Non-secure DPM password is correct</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The result of Non-secure DPM password is incorrect</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWUOK</name>
              <description>Non-secure DPM Password Updated Flag\nThis bit indicates Non-secure DPM password has been updated correctly.\nWhen read:\nNote: This flag is write-one-clear.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No successful updating process has happened</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>There is at least one successful updating process since last clearing of this bit</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PWFMAX</name>
              <description>Non-secure DPM Password Fail Times Maximum Reached Flag (Read Only)\nThis bit indicates if the fail times of comparing Non-secure DPM password reached max times.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Max time has not reached and Non-secure DPM password comparison can be triggered</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Max time reached and Non-secure DPM password comparison cannot be processed anymore</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>PWUCNT</name>
              <description>Non-secure DPM Password Updated Times (Read Only)\nThis bit indicates how many times of non-secure password has been updated.\nThe max value is 7. If PWUCNT reached the max value, Non-secure DPM password cannot be updated anymore.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DBGDIS</name>
              <description>Non-secure Debug Disable Flag (Read Only)\nThis bit indicates the current value of DBGDISNS bit.\n{PWOK, LOCK, DBGDIS} bits define the current state of DPM.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>DEFAULT state.\nLOCKED state</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CLOSE state</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>5</name>
                    <description>OPEN state</description>
                    <value>#101</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>LOCK</name>
              <description>Non-secure Debug Lock Flag (Read Only)\nThis bit indicates the current value of LOCKNS bit.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PWOK</name>
              <description>Non-secure Password OK Flag (Read Only)\nThis bit indicates the Non-secure DPM password has been checked and is correct.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The Non-secure DPM password has not been checked pass, yet</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The Non-secure DPM password has been checked pass since last cold reset</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_NSPW0</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_NSPW0</displayName>
          <description>Non-secure DPM Password 0</description>
          <addressOffset>0x60</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[31:0] to this register to update or compare Non-secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_NSPW1</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_NSPW1</displayName>
          <description>Non-secure DPM Password 1</description>
          <addressOffset>0x64</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[63:32] to this register to update or compare Non-secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_NSPW2</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_NSPW2</displayName>
          <description>Non-secure DPM Password 2</description>
          <addressOffset>0x68</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[95:64] to this register to update or compare Non-secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_NSPW3</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_NSPW3</displayName>
          <description>Non-secure DPM Password 3</description>
          <addressOffset>0x6C</addressOffset>
          <access>write-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PW</name>
              <description>Password\nWrite password[127:96] to this register to update or compare Non-secure DPM password. It is write-only and always read as 0xFFFFFFFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>FVC</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0x4002F500</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x10</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x20</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>FVC_CTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>FVC_CTL</displayName>
          <description>FVC Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFF0</resetMask>
          <fields>
            <field>
              <name>INIT</name>
              <description>FVC Init Bit\nSet to 1 to enable FVC\nThis bit is writable when FVC is at Reset state.\nNote: After set to 1, this bit is cleared to 0 automatically when FVC is back to Reset state.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MONOEN</name>
              <description>Monotonic Enable Bit\nSet to 1 to enable the monotonic mechanism of FVC.\nNote: This bit can be set to1 but cannot be cleared to 0.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WVCODE</name>
              <description>Verification Code\nWhen written, this field must be 0x7710</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>FVC_STS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>FVC_STS</displayName>
          <description>FVC Status Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFF0</resetMask>
          <fields>
            <field>
              <name>BUSY</name>
              <description>FVC Busy Bit\nIndicates the FVC is at busy state.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RDY</name>
              <description>FVC Ready Bit\nIndicates the FVC is ready after the initial process.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>FVC_BL2</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>FVC_BL2</displayName>
          <description>BL2 Firmware Control Register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <field>
              <name>FWVER</name>
              <description>Firmware Version\nRead: Indicates the current firmware version of BL2.\nWrite: Updates the firmware version of BL2.\nThe maximum value of this field is 63.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WVCODE</name>
              <description>Verification Code\nWhen written, this field must be the current firmware version number</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>FVC_BL32</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>FVC_BL32</displayName>
          <description>BL32 Firmware Control Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <field>
              <name>FWVER</name>
              <description>Firmware Version\nRead: Indicates the current firmware version of BL32.\nWrite: Updates the firmware version of BL32.\nThe maximum value of this field is 63.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WVCODE</name>
              <description>Verification Code\nWhen written, this field must be the current firmware version number</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>FVC_BL33</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>FVC_BL33</displayName>
          <description>BL33 Firmware Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <field>
              <name>FWVER</name>
              <description>Firmware Version\nRead: Indicates the current firmware version of BL33.\nWrite: Updates the firmware version of BL33.\nThe maximum value of this field is 255.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WVCODE</name>
              <description>Verification Code\nWhen written, this field must be the current firmware version number</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>FVC_UDF</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>FVC_UDF</displayName>
          <description>User-defined Firmware Control Register</description>
          <addressOffset>0x24</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <field>
              <name>FWVER</name>
              <description>Firmware Version\nRead: Indicates the current firmware version of user's firmware.\nWrite: Updates the firmware version of user's firmware.\nThe maximum value of this field is 255.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WVCODE</name>
              <description>Verification Code\nWhen written, this field must be the current firmware version number</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PLM</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0x4002F700</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>PLM_CTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PLM_CTL</displayName>
          <description>Product Life-cycle Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFF0</resetMask>
          <fields>
            <field>
              <name>STAGE</name>
              <description>Life-cycle Stage Update Bits\nBits to update PLM stage. All bits can be set to one but cannot be cleared to 0.\nOther value will be ignored.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>1</name>
                    <description>progress to OEM stage</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>progress to Deployed stage</description>
                    <value>#011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>7</name>
                    <description>progress to RMA stage</description>
                    <value>#111</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>WVCODE</name>
              <description>Write Verify Code\nThe code is 0x475A for a valid write to this register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PLM_STS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PLM_STS</displayName>
          <description>Product Life-cycle Status Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFF0</resetMask>
          <fields>
            <field>
              <name>STAGE</name>
              <description>Life-cycle Stage (Read Only)\nIndicates the current stage of PLM.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Vendor Stage</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>OEM Stage</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Deployed Stage</description>
                    <value>#011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>7</name>
                    <description>RMA Stage</description>
                    <value>#111</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>DIRTY</name>
              <description>DIRTY Bit (Read Only)\nIndicate the life-cycle stage has been progressed after last cold-reset. Value of STAGE bits is not Current stage of PLM. It needs a cold reset to make it work.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCU</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0x4002F000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x24</offset>
        <size>0x48</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x74</offset>
        <size>0x58</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xF0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x100</offset>
        <size>0x1C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x120</offset>
        <size>0x18</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x140</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x200</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>SCU_PNSSET0</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SCU_PNSSET0</displayName>
          <description>Peripheral Non-secure Attribution Set Register0 (0x4000_0000~0x4001_FFFF)</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>USBH</name>
              <description>Set USBH to Non-secure State\nWrite 1 to set USBH to non-secure state. </description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>USBH is a secure module (default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>USBH is a non-secure module</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>SDH0</name>
              <description>Set SDH0 to Non-secure State\nWrite 1 to set SDH0 to non-secure state. </description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>SDH0 is a secure module (default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>SDH0 is a non-secure module</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>EBI</name>
              <description>Set EBI to Non-secure State\nWrite 1 to set EBI to non-secure state. </description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>EBI is a secure module (default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>EBI is a non-secure module</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PDMA1</name>
              <description>Set PDMA1 to Non-secure State\nWrite 1 to set PDMA1 to non-secure state. </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PDMA1 is a secure module (default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PDMA1 is a non-secure module</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>SCU_PNSSET1</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SCU_PNSSET1</displayName>
          <description>Peripheral Non-secure Attribution Set Register1 (0x4002_0000~0x4003_FFFF)</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CRC</name>
              <description>Set CRC to Non-secure State\nWrite 1 to set CRC to non-secure state. </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>CRC is a secure module (default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRC is a non-secure module</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>CRPT</name>
              <description>Set CRPT to Non-secure State</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>CRPT is a secure module (default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRPT is a non-secure module</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>SCU_PNSSET2</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SCU_PNSSET2</displayName>
          <description>Peripheral Non-secure Attribution Set Register2 (0x4004_0000~0x4005_FFFF)</description>
          <addressOffset>0x8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EWDT</name>
              <description>Set EWDT to Non-secure State\nWrite 1 to set EWDT to non-secure state.</description>
