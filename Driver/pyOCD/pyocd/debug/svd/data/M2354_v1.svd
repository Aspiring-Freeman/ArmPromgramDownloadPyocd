            <field>
              <name>DBCLKSRC</name>
              <description>De-bounce Counter Clock Source Selection (Secure only)\nNote: This bit is only accessible from the Secure state.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
