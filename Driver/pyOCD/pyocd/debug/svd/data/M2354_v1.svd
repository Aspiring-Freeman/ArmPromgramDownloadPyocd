          <name>EPWM_CPSCBUF0_1</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>EPWM_CPSCBUF0_1</displayName>
          <description>EPWM CLKPSC0_1 Buffer</description>
          <addressOffset>0x334</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CPSCBUF</name>
              <description>EPWM Counter Clock Prescale Buffer\nUsed as EPWM counter clock pre-scare active register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
       </register>
