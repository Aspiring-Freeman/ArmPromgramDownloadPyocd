       </register>
       <register derivedFrom="PDMAx_DSCT0_SA">
          <name>PDMAx_DSCT3_SA</name>
          <displayName>PDMAx_DSCT3_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x34</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_SA">
          <name>PDMAx_DSCT4_SA</name>
          <displayName>PDMAx_DSCT4_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x44</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_SA">
          <name>PDMAx_DSCT5_SA</name>
          <displayName>PDMAx_DSCT5_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x54</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_SA">
          <name>PDMAx_DSCT6_SA</name>
          <displayName>PDMAx_DSCT6_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x64</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_SA">
          <name>PDMAx_DSCT7_SA</name>
          <displayName>PDMAx_DSCT7_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x74</addressOffset>
       </register>
       <register>
          <name>PDMAx_DSCT0_DA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PDMAx_DSCT0_DA</displayName>
          <description>Destination Address Register of PDMA Channel n</description>
          <addressOffset>0x8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>DA</name>
              <description>PDMA Transfer Destination Address\nThis field indicates a 32-bit destination address of PDMA controller.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
