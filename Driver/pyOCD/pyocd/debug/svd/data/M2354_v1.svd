                 <enumeratedValue>
                    <name>28</name>
                    <description>Integer part of detected value is 32780</description>
                    <value>#11100</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>29</name>
                    <description>Integer part of detected value is 32781</description>
                    <value>#11101</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>30</name>
                    <description>Integer part of detected value is 32782</description>
                    <value>#11110</value>
