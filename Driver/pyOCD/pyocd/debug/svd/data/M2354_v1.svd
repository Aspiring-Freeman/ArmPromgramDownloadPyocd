          <name>SYS_VTORSET</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_VTORSET</displayName>
          <description>VTOR Setting Register</description>
          <addressOffset>0xA0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VTORSET</name>
              <description>VTOR Setting After SPD Wakeup (Write Protect)\nThis is the register to set the address of vector table after chip is waked up from SPD mode.\nThe value will be loaded to Vector Table Offset Register, which is at the address 0xE000ED08, when chip wake up from SPD mode.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
