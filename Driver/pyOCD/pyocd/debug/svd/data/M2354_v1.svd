       <register>
          <name>PDMAx_PRISET</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PDMAx_PRISET</displayName>
          <description>PDMA Fixed Priority Setting Register</description>
          <addressOffset>0x410</addressOffset>
