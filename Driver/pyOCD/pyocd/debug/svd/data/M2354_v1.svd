          <displayName>CRYPTO_ECC_X1_05</displayName>
          <description>ECC the X-coordinate Word5 of the First Point</description>
          <addressOffset>0x1C</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_ECC_X1_00">
          <name>CRYPTO_ECC_X1_06</name>
          <displayName>CRYPTO_ECC_X1_06</displayName>
          <description>ECC the X-coordinate Word6 of the First Point</description>
          <addressOffset>0x20</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_ECC_X1_00">
          <name>CRYPTO_ECC_X1_07</name>
          <displayName>CRYPTO_ECC_X1_07</displayName>
          <description>ECC the X-coordinate Word7 of the First Point</description>
          <addressOffset>0x24</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_ECC_X1_00">
          <name>CRYPTO_ECC_X1_08</name>
          <displayName>CRYPTO_ECC_X1_08</displayName>
          <description>ECC the X-coordinate Word8 of the First Point</description>
          <addressOffset>0x28</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_ECC_X1_00">
          <name>CRYPTO_ECC_X1_09</name>
          <displayName>CRYPTO_ECC_X1_09</displayName>
          <description>ECC the X-coordinate Word9 of the First Point</description>
