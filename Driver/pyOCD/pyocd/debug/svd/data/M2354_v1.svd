                 <enumeratedValue>
                    <name>2</name>
                    <description>EPWM_CHn up-count compared point</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>EPWM_CHn down-count compared point</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
