       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT3_CTL</name>
          <displayName>PDMAx_DSCT3_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x30</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT4_CTL</name>
          <displayName>PDMAx_DSCT4_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x40</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT5_CTL</name>
          <displayName>PDMAx_DSCT5_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x50</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT6_CTL</name>
          <displayName>PDMAx_DSCT6_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x60</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT7_CTL</name>
          <displayName>PDMAx_DSCT7_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x70</addressOffset>
       </register>
       <register>
          <name>PDMAx_DSCT0_SA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PDMAx_DSCT0_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>SA</name>
              <description>PDMA Transfer Source Address\nThis field indicates a 32-bit source address of PDMA controller.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register derivedFrom="PDMAx_DSCT0_SA">
          <name>PDMAx_DSCT1_SA</name>
          <displayName>PDMAx_DSCT1_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x14</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_SA">
          <name>PDMAx_DSCT2_SA</name>
          <displayName>PDMAx_DSCT2_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
