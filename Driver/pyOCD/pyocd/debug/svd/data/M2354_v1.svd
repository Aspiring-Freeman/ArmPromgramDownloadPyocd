       <register derivedFrom="CRYPTO_HMAC_FDBCK0">
          <name>CRYPTO_HMAC_FDBCK46</name>
          <displayName>CRYPTO_HMAC_FDBCK46</displayName>
          <description>SHA/HMAC Output Feedback Data 46 After SHA/HMAC Operation</description>
          <addressOffset>0x110</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_HMAC_FDBCK0">
          <name>CRYPTO_HMAC_FDBCK47</name>
          <displayName>CRYPTO_HMAC_FDBCK47</displayName>
          <description>SHA/HMAC Output Feedback Data 47 After SHA/HMAC Operation</description>
          <addressOffset>0x114</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_HMAC_FDBCK0">
          <name>CRYPTO_HMAC_FDBCK48</name>
          <displayName>CRYPTO_HMAC_FDBCK48</displayName>
          <description>SHA/HMAC Output Feedback Data 48 After SHA/HMAC Operation</description>
          <addressOffset>0x118</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_HMAC_FDBCK0">
          <name>CRYPTO_HMAC_FDBCK49</name>
          <displayName>CRYPTO_HMAC_FDBCK49</displayName>
