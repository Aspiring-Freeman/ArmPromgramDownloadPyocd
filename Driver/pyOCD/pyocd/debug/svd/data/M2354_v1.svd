       <register>
          <name>PB_DINOFF</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PB_DINOFF</displayName>
          <description>PB Digital Input Path Disable Control</description>
          <addressOffset>0x4</addressOffset>
