       <register>
          <name>PC_DBCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PC_DBCTL</displayName>
          <description>PC Interrupt De-bounce Control Register</description>
          <addressOffset>0x34</addressOffset>
