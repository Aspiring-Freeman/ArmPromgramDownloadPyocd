          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MADDR5</name>
              <description>RSA DMA Middle Address Register5\nThe RSA accelerator supports DMA function to transfer the DATA and PARAMETER between SRAM memory space and RSA accelerator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>CRYPTO_RSA_MADDR6</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CRYPTO_RSA_MADDR6</displayName>
          <description>RSA DMA Middle Address Register6</description>
          <addressOffset>0xB38</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MADDR6</name>
              <description>RSA DMA Middle Address Register6\nThe RSA accelerator supports DMA function to transfer the DATA and PARAMETER between SRAM memory space and RSA accelerator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
