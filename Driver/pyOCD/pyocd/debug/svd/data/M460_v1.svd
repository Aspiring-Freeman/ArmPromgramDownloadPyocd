                    <value>#10100</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>21</name>
                    <description>Integer part of detected value is 32773</description>
                    <value>#10101</value>
                 </enumeratedValue>
                 <enumeratedValue>
