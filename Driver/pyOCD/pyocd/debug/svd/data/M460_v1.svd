                    <value>#01001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>10</name>
                    <description>Integer part of detected value is 32762</description>
                    <value>#01010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>11</name>
                    <description>Integer part of detected value is 32763</description>
                    <value>#01011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>12</name>
                    <description>Integer part of detected value is 32764</description>
                    <value>#01100</value>
                 </enumeratedValue>
                 <enumeratedValue>
