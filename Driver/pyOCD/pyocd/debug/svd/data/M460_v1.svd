                    <name>0</name>
                    <description>Sample Module 18 interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Sample Module 18 interrupt Enabled</description>
                    <value>#1</value>
