              <description>EPWM0_SYNC_IN Noise Filter Enable Bits</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Noise filter of input pin EPWM0_SYNC_IN Disabled</description>
                    <value>#0</value>
