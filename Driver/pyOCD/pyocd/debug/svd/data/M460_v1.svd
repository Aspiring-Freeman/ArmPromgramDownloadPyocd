              <access>read-write</access>
            </field>
            <field>
              <name>MISMATIE</name>
              <description>Mismatch Interrupt Enable Bit\nThis field is used to enable mismatch interrupt.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Mismatch interrupt Disabled</description>
                    <value>#0</value>
