          <fields>
            <field>
              <name>ADDRHI</name>
              <description>MAC Address0 [47:32]\nThis field contains the upper 16 bits (47:32) of the first 6-byte MAC address. The MAC uses this field for filtering the received frames and inserting the MAC address in the Transmit Flow Control (PAUSE) Frames.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AE</name>
              <description>Address Enable (read only)\nThis bit is always set to 1.</description>
