                 <enumeratedValue>
                    <name>5</name>
                    <description>GPA.5 wake-up function Enabled</description>
                    <value>#0101</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>6</name>
                    <description>GPA.6 wake-up function Enabled</description>
                    <value>#0110</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>7</name>
                    <description>GPA.7 wake-up function Enabled</description>
                    <value>#0111</value>
