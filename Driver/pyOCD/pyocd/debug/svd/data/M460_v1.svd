                 <enumeratedValue>
                    <name>1</name>
                    <description>Sample Module 16 interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>SPLIE17</name>
