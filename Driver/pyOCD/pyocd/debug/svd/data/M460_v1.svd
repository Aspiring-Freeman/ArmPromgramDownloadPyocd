                 <enumeratedValue>
                    <name>111</name>
                    <description>Channel connects to BMC1</description>
                    <value>111</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>112</name>
                    <description>Channel connects to BMC2</description>
                    <value>112</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>113</name>
                    <description>Channel connects to BMC3</description>
                    <value>113</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>114</name>
                    <description>Channel connects to BMC4</description>
                    <value>114</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>115</name>
                    <description>Channel connects to BMC5</description>
                    <value>115</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>116</name>
                    <description>Channel connects to BMC6</description>
                    <value>116</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>117</name>
                    <description>Channel connects to BMC7</description>
                    <value>117</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>REQSRC1</name>
              <description>Channel 1 Request Source Selection\nThis filed defines which peripheral is connected to PDMA channel 1. User can configure the peripheral setting by REQSRC1. \nNote: The channel configuration is the same as REQSRC0 field. Please refer to the explanation of REQSRC0.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REQSRC2</name>
              <description>Channel 2 Request Source Selection\nThis filed defines which peripheral is connected to PDMA channel 2. User can configure the peripheral setting by REQSRC2. \nNote: The channel configuration is the same as REQSRC0 field. Please refer to the explanation of REQSRC0.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REQSRC3</name>
              <description>Channel 3 Request Source Selection\nThis filed defines which peripheral is connected to PDMA channel 3. User can configure the peripheral setting by REQSRC3. \nNote: The channel configuration is the same as REQSRC0 field. Please refer to the explanation of REQSRC0.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PDMAx_REQSEL4_7</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PDMAx_REQSEL4_7</displayName>
          <description>PDMA Request Source Select Register 1</description>
          <addressOffset>0x484</addressOffset>
