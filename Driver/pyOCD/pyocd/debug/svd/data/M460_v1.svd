            <field>
              <name>SPLCNT</name>
              <description>Slot Period Loop Count\n000000 ~ 111110 is loop count.\nNote 1: If setting this register 111111 with PDMA mode and OUTPUT mode, it will stop automatically when PDMA is finished and output data in shift register is finished.\nNote 2: If setting this register 111111 with PDMA mode and INPUT mode, it will stop automatically when PDMA is finished.\nNote 3: If PSIO receives stop instruction during repeat mode, it will stop only when the current loop is finished.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Slot period loop count function is disable</description>
                    <value>#000000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Repeat selection loop once, which means total go through selected repeat slots 2 times</description>
                    <value>#000001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>63</name>
                    <description>Loop until stop PSIO slot controller</description>
                    <value>#111111</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>TRIGSRC</name>
              <description>PSIO_SCn Trigger Source\nNote 1: PSIO slot controller pin can only be triggered by related pins set from SCSEL(PSIOn_GENCTL[25:24]).\nNote 2: Configuring rising or falling signal trigger PSIO, the signal needs to hold for at least two PSIO_CLK for de-bounce or PSIO will not be triggered.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Trigger by software</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trigger PSIO_SCn when related PSIO_PIN occurred falling edge</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Trigger PSIO_SCn when related PSIO_PIN occurred rising edge</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Trigger PSIO_SCn when related PSIO_PIN occurred rising edge or falling edge</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>START</name>
              <description>PSIO_SCn Start\nNote: This bit is always read as 0.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No use</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Start PSIO_SCn to count and active related PSIO_PIN</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>REPEAT</name>
              <description>Whole Repeat Mode\nSlot controller repeats counting forever.\nNote 1: If this bit is enabled with PDMA mode, slot controller will stop automatically when the PDMA finishes transferring number of data.\nNote 2: If PSIO receives stop instruction during repeat mode, it will stop only when the current loop is finished.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Repeat mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Repeat mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>STOP</name>
              <description>PSIO_SCn Stop\nNote: This bit is always read as 0.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No use</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Stop PSIO_SCn</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>BUSY</name>
              <description>PSIO_SCn Busy Flag\nNote: This bit will be set to 1 when slot controller starts to count automatically and it will be cleared to 0 automatically when slot controller stops counting, too.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PSIO_SCn is not busy</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PSIO_SCn is busy</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>IDLE</name>
              <description>PSIO_SCn Idle Flag\nNote 1: This bit will be cleared to 0 when slot controller starts to count automatically. \nNote 2: This bit will be set to 1 when configuring it 1 by software. \nNote 3: This bit is set to distinguish INTERVAL (PSIOn_GENCTL[5:4]) and INITIAL (PSIOn_GENCTL[3:2]).</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PSIO_SCn is not IDLE</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PSIO_SCn is IDLE</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register derivedFrom="PSIO_SC0CTL">
          <name>PSIO_SC1CTL</name>
          <displayName>PSIO_SC1CTL</displayName>
          <description>PSIO Slot Controller n Control Register</description>
          <addressOffset>0x28</addressOffset>
       </register>
       <register derivedFrom="PSIO_SC0CTL">
          <name>PSIO_SC2CTL</name>
