                    <name>0</name>
                    <description>Comparator output filter clock = PCLK</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Comparator output filter clock = PCLK/2</description>
