                 <enumeratedValue>
                    <name>1</name>
                    <description>Standby power-down wake-up pin De-bounce function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
