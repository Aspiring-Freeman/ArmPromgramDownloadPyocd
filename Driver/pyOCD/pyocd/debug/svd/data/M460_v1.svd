              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>SOF interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>SOF interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>RSTIEN</name>
              <description>Reset Interrupt Enable Bit\nThis bit enables the USB-Reset interrupt.</description>
              <bitOffset>1</bitOffset>
