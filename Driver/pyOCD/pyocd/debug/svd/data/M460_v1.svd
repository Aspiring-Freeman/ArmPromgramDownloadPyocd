              <name>RBSA</name>
              <description>Rx Buffer Start Address\nCongures the start address of the Rx Buffers section in the Message RAM (32-bit word address).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
