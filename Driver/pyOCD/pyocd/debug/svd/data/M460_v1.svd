              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FTCMU2</name>
              <description>EPWM FTCMPDAT Up Indicator\nIndicator is set by hardware when EPWM counter up counts and reaches EPWM_FTCMPDATn. Software can clear this bit by writing 1 to it.</description>
