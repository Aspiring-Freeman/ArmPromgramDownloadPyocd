                 <enumeratedValue>
                    <name>3</name>
                    <description>PWMx_CH1 output high level when PWMx_BRAKEy brake event happened</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
