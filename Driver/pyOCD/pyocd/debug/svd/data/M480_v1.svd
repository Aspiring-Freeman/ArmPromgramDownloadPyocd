          <name>CRYPTO_AES0_KEY1</name>
          <displayName>CRYPTO_AES0_KEY1</displayName>
          <description>AES Key Word 1 Register for Channel 0</description>
          <addressOffset>0x114</addressOffset>
       </register>
       <register derivedFrom="CRYPTO_AES0_KEY0">
