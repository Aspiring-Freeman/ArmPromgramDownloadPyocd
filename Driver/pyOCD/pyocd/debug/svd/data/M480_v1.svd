            <field>
              <name>PFWKEN</name>
              <description>Pin Falling Edge Wake-up Enable Bit</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
