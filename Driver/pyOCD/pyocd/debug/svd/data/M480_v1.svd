                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Brake pin source comes from PWM0_BRAKE1 pin</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Brake pin source comes from PWM1_BRAKE0 pin</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Brake pin source comes from PWM1_BRAKE1 pin</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
