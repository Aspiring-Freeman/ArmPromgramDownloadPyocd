          <fields>
            <field>
              <name>WKEN</name>
              <description>Standby Power-down Pin Wake-up Enable Bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
