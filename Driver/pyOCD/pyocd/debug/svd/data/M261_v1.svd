                 <enumeratedValue>
                    <name>1</name>
                    <description>External interrupt from PA.6, or PB.5 pin NMI source Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
