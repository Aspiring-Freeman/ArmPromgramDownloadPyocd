          <fields>
            <field>
              <name>IFAIF0</name>
              <description>EPWM_CHn Interrupt Flag Accumulator Interrupt Flag\nFlag is set by hardware when condition match IFASEL in EPWM_IFAn register, software can clear this bit by writing 1 to it.</description>
