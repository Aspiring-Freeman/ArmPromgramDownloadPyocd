            <field>
              <name>CMPDCTL5</name>
              <description>EPWM Compare Down Point Control\nEPWM can control output level when EPWM counter counts down to CMPDAT.\nNote: In complementary mode, CMPDCTL1, 3, 5 is used as another CMPDCTL for channel 0, 2, 4.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
