              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Brake 0 pin source come from EPWM0_BRAKE0.\nBrake 0 pin source come from EPWM1_BRAKE0</description>
                    <value>#0</value>
                 </enumeratedValue>
