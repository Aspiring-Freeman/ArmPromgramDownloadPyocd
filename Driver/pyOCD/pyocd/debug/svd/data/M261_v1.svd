       <register>
          <name>CRYPTO_ECC_Y1_00</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CRYPTO_ECC_Y1_00</displayName>
          <description>ECC The Y-coordinate word0 of the first point</description>
          <addressOffset>0x850</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
